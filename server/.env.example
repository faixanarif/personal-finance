# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Authentication / Security
JWT_SECRET=super_secret_jwt_finance_key_change_in_production_!@#$
JWT_EXPIRES_IN=7d

# Database Layer Selection ('memory' or 'mysql')
DB_DRIVER=memory

# MySQL Database Configuration (Used when DB_DRIVER=mysql)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=personalfinancedb
